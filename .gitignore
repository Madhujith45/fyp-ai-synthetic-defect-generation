# Python cache and build artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
*.secret
*.key
*.pem
*.token

# Models and checkpoints
models/
checkpoints/
*.ckpt
*.safetensors
*.pt
*.pth
*.bin

# Tooling and test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# IDE and OS files
.vscode/
.idea/
.agents/
Thumbs.db
.DS_Store

# Datasets (preserve .gitkeep, exclude all raw, processed, synthetic images)
data/raw/
data/processed/*
!data/processed/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep

# Project outputs (preserve .gitkeep, exclude generated outputs and evaluation artifacts)
outputs/*
!outputs/.gitkeep
